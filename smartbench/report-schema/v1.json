{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SmartBench report",
  "description": "Versioned deterministic analysis report returned by AnalysisSession.report().",
  "type": "object",
  "required": [
    "schema_version",
    "findings",
    "stats",
    "duration_ms",
    "errors",
    "analysis_status",
    "pipeline",
    "project_reader",
    "fingerprint",
    "ir_schema_version",
    "ir_languages",
    "ir_capabilities",
    "ir_source_units",
    "evidence_packs"
  ],
  "properties": {
    "schema_version": {
      "const": "smartbench.report/v1"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "analysis_status": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "analysis_method": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": true
    },
    "project_reader": {
      "type": "object",
      "additionalProperties": true
    },
    "fingerprint": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "ir_schema_version": {
      "type": ["string", "null"]
    },
    "ir_languages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ir_capabilities": {
      "type": "object",
      "additionalProperties": true
    },
    "ir_source_units": {
      "type": "object",
      "additionalProperties": true
    },
    "evidence_packs": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$defs": {
    "location": {
      "type": "object",
      "required": ["file_path", "line_start"],
      "properties": {
        "file_path": {
          "type": "string"
        },
        "line_start": {
          "type": "integer",
          "minimum": 1
        },
        "line_end": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "column_start": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "column_end": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "finding": {
      "type": "object",
      "required": [
        "rule_id",
        "rule_name",
        "severity",
        "location",
        "message",
        "evidence",
        "confidence",
        "metadata"
      ],
      "properties": {
        "rule_id": {
          "type": "string"
        },
        "rule_name": {
          "type": "string"
        },
        "severity": {
          "enum": ["error", "warning", "info"]
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "message": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/location"
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
